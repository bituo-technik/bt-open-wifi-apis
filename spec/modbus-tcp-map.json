    "zh-CN": "docs/modbus-tcp/modbus-tcp-api.zh-CN.md",
    "en": "docs/modbus-tcp/modbus-tcp-api.en.md"
  },
  "port": 502,
  "unitId": "not checked by firmware (use 1)",
  "functionCodes": {
    "0x03": "read holding registers",
    "0x04": "read input registers (same data)",
    "0x06": "write single register (control only)"
  },
  "readWindow": {
    "start": 978,
    "count": 100,
    "end": 1077
  },
  "wordOrder": "high word at lower address (ABCD)",
  "maxClients": {
    "basic": 2,
    "lite": 2,
    "basicPlus": 1,
    "pro": 2
  },
  "idleTimeoutSeconds": {
    "standardBuild": 30,
    "customBuild": 12
  },
  "perRequest": "one request per response; if several ADUs are queued only the newest is answered",
  "maxFrameBytes": 600,
  "functionMapBit": {
    "modbusTcp": 15,
    "tls": 14
  },
  "identification": [
    {
      "address": 978,
      "hex": "0x03D2",
      "registers": 6,
      "type": "string",
      "en": "MAC address",
      "zh": "设备 MAC 地址（12 个字符）",
      "example": "e.g. 45705E597760"
