  "doc": {
    "zh-CN": "docs/reference/error-codes.zh-CN.md",
    "en": "docs/reference/error-codes.en.md"
  },
  "rule": "code is present only when ok=false; code = channelBase + subcode for configuration errors; fixed codes share the same ranges, so disambiguate by event + English msg",
  "channelBase": {
    "ble": 1000,
    "http": 2000,
    "mqtt": 3000,
    "websocket": 4000
  },
  "noSpecificCode": -1,
